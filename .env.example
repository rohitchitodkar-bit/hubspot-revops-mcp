# ── RevOps MCP Server ────────────────────────────────────────────────────────
# HubSpot Private App token (read-only) — used by the MCP server at runtime.
# Create at: HubSpot → Settings → Integrations → Private Apps → Create a private app
#
# Required scopes (8 total):
#   automation
#   crm.objects.contacts.read
#   crm.objects.companies.read
#   crm.objects.deals.read
#   crm.objects.owners.read
#   crm.schemas.contacts.read
#   crm.schemas.companies.read
#   crm.schemas.deals.read
#
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── UAT Seed Script (local use only) ─────────────────────────────────────────
# Separate Private App token with WRITE access — used only to populate test
# data via: npx tsx scripts/seed-uat.ts
# Delete this app after UAT is complete. Never deploy this token to Vercel.
#
# Additional scopes needed (on top of the 8 above):
#   crm.objects.contacts.write
#   crm.objects.companies.write
#   crm.objects.deals.write
#
UAT_SEED_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
